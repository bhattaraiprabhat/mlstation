m, Segoe UI, sans-serif\",\"size\":13},\"hoverlabel\":{\"bordercolor\":\"rgba(0,0,0,0)\",\"font\":{\"family\":\"Inter, system-ui, -apple-system, Segoe UI, sans-serif\",\"size\":12}},\"legend\":{\"bgcolor\":\"rgba(0,0,0,0)\",\"orientation\":\"h\",\"x\":0,\"xanchor\":\"left\",\"y\":1.02,\"yanchor\":\"bottom\"},\"margin\":{\"b\":44,\"l\":48,\"r\":16,\"t\":40},\"paper_bgcolor\":\"rgba(0,0,0,0)\",\"plot_bgcolor\":\"rgba(0,0,0,0)\",\"title\":{\"font\":{\"size\":15},\"x\":0,\"xanchor\":\"left\"},\"xaxis\":{\"gridcolor\":\"rgba(138,147,163,0.18)\",\"linecolor\":\"rgba(138,147,163,0.18)\",\"ticks\":\"\",\"title\":{\"standoff\":10},\"zeroline\":false},\"yaxis\":{\"gridcolor\":\"rgba(138,147,163,0.18)\",\"linecolor\":\"rgba(138,147,163,0.18)\",\"ticks\":\"\",\"title\":{\"standoff\":10},\"zeroline\":false}}},\"shapes\":[{\"line\":{\"color\":\"#F43F5E\",\"dash\":\"dash\"},\"type\":\"line\",\"x0\":0,\"x1\":1,\"xref\":\"x domain\",\"y0\":56.0,\"y1\":56.0,\"yref\":\"y\"}],\"annotations\":[{\"showarrow\":false,\"text\":\"Always-on server sized for peak\",\"x\":0,\"xanchor\":\"left\",\"xref\":\"x domain\",\"y\":56.0,\"yanchor\":\"bottom\",\"yref\":\"y\"}],\"height\":360,\"yaxis\":{\"title\":{\"text\":\"Requests per minute\"}},\"showlegend\":false},                        {\"displaylogo\": false, \"responsive\": true, \"modeBarButtonsToRemove\": [\"lasso2d\", \"select2d\", \"autoScale2d\"]}                    ).then(function(){\n                            \nvar gd = document.getElementById('1789a020-c678-44ab-afba-4718af5073a6');\nvar x = new MutationObserver(function (mutations, observer) {{\n        var display = window.getComputedStyle(gd).display;\n        if (!display || display === 'none') {{\n            console.log([gd, 'removed!']);\n            Plotly.purge(gd);\n            observer.disconnect();\n        }}\n}});\n\n// Listen for the removal of the full notebook cells\nvar notebookContainer = gd.closest('#notebook-container');\nif (notebookContainer) {{\n    x.observe(notebookContainer, {childList: true});\n}}\n\n// Listen for the clearing of the current output cell\nvar outputEl = gd.closest('.output');\nif (outputEl) {{\n    x.observe(outputEl, {childList: true});\n}}\n\n                        })                };            </script>        </div>\n```\n\nSimulated requests per minute over one week. An always-on server is sized for the peak and sits mostly idle.\n:::\n:::\n\n\nOn average the traffic uses only **24%** of the peak capacity. With an always-on server you pay for 100% of it, all week. With **serverless**, you pay per request and per second of compute, and it can **scale to zero** at night.\n\n## Cost calculator\n\nThe prices below are **example values**, not quotes. Replace them with current numbers from your provider's pricing page. The chart shows the monthly cost of each option as traffic grows.\n\n```{ojs}\n//| echo: false\nviewof reqDay = Inputs.range([1000, 5e6], {value: 50000, step: 1000, label: \"Requests per day\", transform: Math.log})\nviewof msReq = Inputs.range([5, 500], {value: 40, step: 5, label: \"Compute time per request (ms)\"})\nviewof vmHour = Inputs.number({value: 0.05, step: 0.01, label: \"Always-on server, $ per hour (example)\"})\nviewof vmCount = Inputs.range([1, 4], {value: 2, step: 1, label: \"Servers kept on (for redundancy)\"})\nviewof perMillion = Inputs.number({value: 0.40, step: 0.05, label: \"Serverless, $ per million requests (example)\"})\nviewof perVcpuS = Inputs.number({value: 0.000024, step: 0.000001, label: \"Serverless, $ per vCPU-second (example)\"})\n```\n\n```{ojs}\n//| echo: false\ncostVM = r => vmHour * 24 * 30 * vmCount\ncostSL = r => (r * 30 / 1e6) * perMillion + r * 30 * (msReq / 1000) * perVcpuS\ncurve = d3.range(3, 6.75, 0.05).map(e => 10 ** e).flatMap(r => [{r, cost: costVM(r), option: \"Always-on servers\"}, {r, cost: costSL(r), option: \"Serverless\"}])\nbreakEven = curve.filter(d => d.option === \"Serverless\").find(d => d.cost > costVM(d.r))\nPlot.plot({\n  ...msStyle, height: 360, width: 760, marginLeft: 60,\n  x: {type: \"log\", label: \"Requests per day →\"}, y: {label: \"↑ $ per month\", grid: true},\n  color: {domain: [\"Always-on servers\", \"Serverless\"], range: [ms.rose, ms.teal], legend: true},\n  marks: [\n    Plot.line(curve, {x: \"r\", y: \"cost\", stroke: \"option\", strokeWidth: 3}),\n    Plot.ruleX([reqDay], {stroke: ms.indigo, strokeDasharray: \"4,4\"}),\n    breakEven ? Plot.ruleX([breakEven.r], {stroke: \"currentColor\", strokeOpacity: 0.4}) : null,\n    breakEven ? Plot.text([breakEven], {x: \"r\", y: d => costVM(d.r), text: d => `break-even ≈ ${d3.format(\".2s\")(d.r)}/day`, dy: -12, fill: \"currentColor\", fontSize: 12}) : null\n  ]\n})\n```\n\n```{ojs}\n//| echo: false\nhtml`<div class=\"ms-readout\"><span>At ${d3.format(\",\")(reqDay)} requests a day</span><b>$${costSL(reqDay).toFixed(2)} serverless vs $${costVM(reqDay).toFixed(2)} always-on</b><span>${costSL(reqDay) < costVM(reqDay) ? \"Serverless is cheaper at this volume.\" : \"Steady high volume favours always-on servers.\"}</span></div>`\n```\n\nThe pattern is general: **pay-per-use wins at low or spiky traffic; reserved capacity wins at steady high traffic.** Many teams start serverless and move to reserved servers or Kubernetes when volume becomes large and steady.\n\n## Choosing a platform\n\n```{mermaid}\n%%| echo: false\nflowchart TD\n  A[New model to deploy] --> B{Need a GPU?}\n  B -- yes --> C{Large team and<br/>many models?}\n  C -- yes --> D[Managed ML platform<br/>or Kubernetes with GPUs]\n  C -- no --> E[Managed ML endpoint<br/>or GPU VM]\n  B -- no --> F{Traffic spiky<br/>or low?}\n  F -- yes --> G[Serverless container<br/>Cloud Run, Container Apps, App Runner]\n  F -- no --> H{Already run<br/>Kubernetes?}\n  H -- yes --> I[Deploy to EKS, GKE or AKS]\n  H -- no --> J[Small VM group<br/>behind a load balancer]\n```\n\n## Deploying PayGuard to a serverless container\n\nGoogle Cloud Run is a good example of the serverless path: build the image, push it, deploy it.\n\n```{.bash filename=\"terminal\"}\n# build and push to Artifact Registry\ngcloud builds submit --tag \\\n  us-central1-docker.pkg.dev/my-proj/ml/payguard:1.4.0\n\n# deploy: scale to zero when idle, at most 10 instances\ngcloud run deploy payguard \\\n  --image us-central1-docker.pkg.dev/my-proj/ml/payguard:1.4.0 \\\n  --region us-central1 --port 8000 \\\n  --min-instances 0 --max-instances 10 \\\n  --cpu 1 --memory 1Gi\n```\n\nThe same container works on AWS App Runner or Azure Container Apps with their own commands. That portability is the reward for using Docker.\n\n## Free and low-cost options\n\nFor learning projects and small sites, you can often pay nothing:\n\n- **Google Cloud Run** has a monthly free tier; with request-based billing it includes **2 million requests, 180,000 vCPU-seconds and 360,000 GiB-seconds** ([Google Cloud](https://cloud.google.com/run/pricing)).\n- **Hugging Face Spaces** offers a free **CPU Basic** tier with 2 vCPUs and 16 GB of memory, good for Gradio or Streamlit demos ([Hugging Face](https://huggingface.co/docs/hub/spaces-overview)).\n- AWS and Azure also offer free tiers and starter credits; check their current terms.\n\n::: {.callout-warning}\n## Set a budget alert on day one\nEvery cloud lets you create a budget with email alerts. A forgotten GPU instance can cost more in a weekend than a year of serverless traffic.\n:::\n\n## Summary\n\n- Four levels: **VM, Kubernetes, serverless container, managed ML platform**. Higher levels mean less work and less control.\n- AWS, Google Cloud and Azure offer **equivalent services** under different names.\n- **Spiky or low traffic favours serverless**; steady heavy traffic favours reserved servers.\n- Keep the model in a container so you can move between clouds.\n- Next: handle traffic spikes in [Scale](/deployment/scale/scaling-ml-inference.qmd).\n\n",
