rowhead\":0,\"arrowwidth\":1},\"geo\":{\"bgcolor\":\"white\",\"landcolor\":\"#E5ECF6\",\"subunitcolor\":\"white\",\"showland\":true,\"showlakes\":true,\"lakecolor\":\"white\"},\"title\":{\"x\":0.05},\"margin\":{\"b\":0,\"l\":0,\"r\":0,\"t\":30}}},\"xaxis\":{\"anchor\":\"y\",\"domain\":[0.0,0.235],\"title\":{\"text\":\"x\"}},\"yaxis\":{\"anchor\":\"x\",\"domain\":[0.0,1.0],\"title\":{\"text\":\"probability density\"}},\"xaxis2\":{\"anchor\":\"y2\",\"domain\":[0.255,0.49],\"matches\":\"x\",\"title\":{\"text\":\"x\"}},\"yaxis2\":{\"anchor\":\"x2\",\"domain\":[0.0,1.0],\"matches\":\"y\",\"showticklabels\":false},\"xaxis3\":{\"anchor\":\"y3\",\"domain\":[0.51,0.745],\"matches\":\"x\",\"title\":{\"text\":\"x\"}},\"yaxis3\":{\"anchor\":\"x3\",\"domain\":[0.0,1.0],\"matches\":\"y\",\"showticklabels\":false},\"xaxis4\":{\"anchor\":\"y4\",\"domain\":[0.7649999999999999,0.9999999999999999],\"matches\":\"x\",\"title\":{\"text\":\"x\"}},\"yaxis4\":{\"anchor\":\"x4\",\"domain\":[0.0,1.0],\"matches\":\"y\",\"showticklabels\":false},\"annotations\":[{\"font\":{},\"showarrow\":false,\"text\":\"Normal\",\"x\":0.1175,\"xanchor\":\"center\",\"xref\":\"paper\",\"y\":1.0,\"yanchor\":\"bottom\",\"yref\":\"paper\"},{\"font\":{},\"showarrow\":false,\"text\":\"Skewed\",\"x\":0.3725,\"xanchor\":\"center\",\"xref\":\"paper\",\"y\":1.0,\"yanchor\":\"bottom\",\"yref\":\"paper\"},{\"font\":{},\"showarrow\":false,\"text\":\"Heavy tail\",\"x\":0.6275,\"xanchor\":\"center\",\"xref\":\"paper\",\"y\":1.0,\"yanchor\":\"bottom\",\"yref\":\"paper\"},{\"font\":{},\"showarrow\":false,\"text\":\"Mixture\",\"x\":0.8824999999999998,\"xanchor\":\"center\",\"xref\":\"paper\",\"y\":1.0,\"yanchor\":\"bottom\",\"yref\":\"paper\"}],\"legend\":{\"tracegroupgap\":0},\"barmode\":\"relative\",\"height\":360,\"showlegend\":false},                        {\"responsive\": true}                    ).then(function(){\n                            \nvar gd = document.getElementById('d202dfb1-da21-4ddb-884a-b17b5b7751ed');\nvar x = new MutationObserver(function (mutations, observer) {{\n        var display = window.getComputedStyle(gd).display;\n        if (!display || display === 'none') {{\n            console.log([gd, 'removed!']);\n            Plotly.purge(gd);\n            observer.disconnect();\n        }}\n}});\n\n// Listen for the removal of the full notebook cells\nvar notebookContainer = gd.closest('#notebook-container');\nif (notebookContainer) {{\n    x.observe(notebookContainer, {childList: true});\n}}\n\n// Listen for the clearing of the current output cell\nvar outputEl = gd.closest('.output');\nif (outputEl) {{\n    x.observe(outputEl, {childList: true});\n}}\n\n                        })                };            </script>        </div>\n```\n\nDifferent shapes can share similar first-order summaries.\n:::\n:::\n\n\n## DS/ML Bridge: why EDA changes modeling decisions\n\n| Statistical clue | Data-science consequence |\n|---|---|\n| Strong skew | Transform feature, robust model, or suitable distribution |\n| Large outliers | Investigate data quality; consider robust loss/scaling |\n| Multiple modes | Hidden subgroups or mixture behavior |\n| Very different scales | Scaling may matter for distance/gradient methods |\n| Missingness pattern | Missingness may itself contain information |\n\n::: {.callout-warning}\n## Common mistake\nDo not automatically delete an outlier because a boxplot marks it. An outlier can be an error, a rare valid case, or the most important observation in the dataset.\n:::\n\n## Save the analysis\n\n```python\nsummary = df.groupby(\"Distribution\")[\"x\"].agg(\n    [\"count\",\"mean\",\"median\",\"std\",\"min\",\"max\"]\n)\nsummary.to_csv(\"eda_summary.csv\")\n```\n\nSave both **summary statistics and plots/configuration**. EDA is part of the reproducible analysis, not disposable scratch work.\n\n## Summary\n- Center, spread and shape describe different properties.\n- Mean/SD are sensitive; median/IQR are robust.\n- Visualization prevents summaries from hiding structure.\n- EDA often determines preprocessing, feature engineering and model assumptions.\n\n**Next:** *Probability by Simulation — Learning Chance by Repetition*\n\n",
